#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1

start_service() {
	[ "$(uci -q get podkop_sattelite.main.enabled)" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/podkop-sattelite/run daemon
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger podkop_sattelite
}
