#!/bin/sh
umask 077
[ -e /etc/config/podkop_sattelite ] || cp /usr/share/podkop-sattelite/defaults /etc/config/podkop_sattelite
chmod 600 /etc/config/podkop_sattelite
mkdir -p /etc/podkop-sattelite
chmod 700 /etc/podkop-sattelite
rm -f /tmp/luci-indexcache
rm -rf /tmp/luci-modulecache
/etc/init.d/podkop_sattelite enable
/etc/init.d/podkop_sattelite restart
exit 0
