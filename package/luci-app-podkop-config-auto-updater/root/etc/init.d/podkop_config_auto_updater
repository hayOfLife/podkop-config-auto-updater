#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1

start_service() {
	mkdir -p /tmp/podkop-config-auto-updater
	chmod 700 /tmp/podkop-config-auto-updater
	if /usr/libexec/podkop-config-auto-updater/ipv6 apply; then
		rm -f /tmp/podkop-config-auto-updater/ipv6-error
	else
		printf '1\n' > /tmp/podkop-config-auto-updater/ipv6-error
		logger -t podkop-config-auto-updater 'Не удалось применить настройку IPv6'
	fi
	# Цикл остаётся для возврата выбора сервера после выключения автоматических действий
	procd_open_instance
	procd_set_param command /usr/libexec/podkop-config-auto-updater/run daemon
	procd_set_param respawn
	procd_close_instance
}

service_stopped() {
	local software_state
	software_state="$(/usr/libexec/podkop-config-auto-updater/software status 2>/dev/null)" || software_state=''
	# Установщик удерживает общий lock до окончания postinst и сам запускает новую службу
	if ucode -e 'let s; try { s = json(ARGV[0]); } catch (e) {} exit(s?.state == "running" && s.target == "self" && s.stage == "installing" ? 0 : 1);' "$software_state"; then
		return 0
	fi
	/usr/libexec/podkop-config-auto-updater/run health-release >/dev/null
}

service_triggers() {
	procd_add_reload_trigger podkop_config_auto_updater
}
