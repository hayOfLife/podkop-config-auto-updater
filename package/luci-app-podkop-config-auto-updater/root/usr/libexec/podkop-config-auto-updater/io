#!/bin/sh
set -eu
exec 8>&- 9>&-
case "$1" in
	browsec-auth)
		work="$2"
		curl --disable --silent --show-error --fail --proto '=https' --max-redirs 0 \
			--connect-timeout 15 --max-time 60 --max-filesize 1048576 \
			--header "@$work/headers" --data-binary "@$work/auth-request" \
			--output "$work/auth-response.json" -- 'https://browsec.com/api/v1/authentication' 2>/dev/null
		;;
	download|reset-default|subscription-download)
		work="$2"
		if [ "$1" = reset-default ]; then output="$work/default-podkop"; else output="$work/feed.json"; fi
		curl_status=0
		if [ "$1" = subscription-download ]; then
			code="$(curl --disable --silent --fail --proto '=https' --max-redirs 0 \
				--connect-timeout 15 --max-time 60 --max-filesize 1048576 \
				--config "$work/subscription-curl" --header "@$work/headers" --output "$output" \
				--write-out '%{http_code}' 2>/dev/null)" || curl_status="$?"
		else
			code="$(curl --disable --silent --fail --proto '=https' --max-redirs 0 \
				--connect-timeout 15 --max-time 60 --max-filesize 1048576 \
				--header "@$work/headers" --output "$output" \
				--write-out '%{http_code}' -- "$3" 2>/dev/null)" || curl_status="$?"
		fi
		error=download_failed
		case "$curl_status" in
			5) error=download_proxy_dns_failed ;;
			6) error=download_dns_failed ;;
			7) error=download_connect_failed ;;
			28) error=download_timeout ;;
			35) error=download_tls_failed ;;
			51|60) error=download_certificate_failed ;;
			77) error=download_ca_failed ;;
			63) error=download_too_large ;;
			47) error=download_http_redirect ;;
			0|22)
				case "$code" in
					200) if [ "$curl_status" = 0 ]; then exit 0; fi ;;
					401) error=download_http_unauthorized ;;
					403) error=download_http_forbidden ;;
					404) error=download_http_not_found ;;
					429) error=download_http_rate_limited ;;
					5[0-9][0-9]) error=download_http_server_error ;;
					3[0-9][0-9]) error=download_http_redirect ;;
					[1-5][0-9][0-9]) error=download_http_error ;;
				esac ;;
		esac
		printf '%s\n' "$error" > "$work/download-error"
		exit 1
		;;
	restart)
		/etc/init.d/podkop restart >/dev/null 2>&1
		;;
	service-state)
		case "${2:-}" in stable) service=sing-box ;; experimental) service=podkop ;; *) exit 2 ;; esac
		[ -x "/etc/init.d/$service" ] || exit 2
		ubus call service list "{\"name\":\"$service\"}" > "$3/service-state.json" 2>/dev/null
		;;
	stop|start)
		/etc/init.d/podkop "$1" >/dev/null 2>&1
		;;
	*) exit 2 ;;
esac
