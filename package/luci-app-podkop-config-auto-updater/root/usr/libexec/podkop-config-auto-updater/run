#!/bin/sh
set -eu
umask 077
case "${1:-}" in
	status)
		ucode -e 'import { readfile } from "fs"; import { cursor } from "uci"; function load(path) { try { return json(readfile(path)) || {}; } catch(e) { return {}; } } let s = load("/tmp/podkop-config-auto-updater/status.json"); let p = load("/etc/podkop-config-auto-updater/schedule.json"); s.enabled = cursor().get("podkop_config_auto_updater", "main", "enabled") == "1"; s.ipv6_error = !!readfile("/tmp/podkop-config-auto-updater/ipv6-error"); s.next_run = p.next; s.fields = load("/tmp/podkop-config-auto-updater/fields.json").fields || []; print(sprintf("%J\n", s));'
		exit 0 ;;
	daemon)
		while :; do "$0" tick >/dev/null 2>&1 || true; sleep 30; done ;;
	update|tick|test) ;;
	*) exit 2 ;;
esac
mkdir -p /tmp/podkop-config-auto-updater
chmod 700 /tmp/podkop-config-auto-updater
if [ "$1" != test ]; then
	mkdir -p /etc/podkop-config-auto-updater
	chmod 700 /etc/podkop-config-auto-updater
fi
exec 9>/tmp/podkop-config-auto-updater/lock
flock -n 9 || { printf '{"state":"error","error":"busy"}\n'; exit 1; }
work="$(mktemp -d /tmp/podkop-config-auto-updater/run.XXXXXX)"
trap 'rm -rf -- "$work"' EXIT HUP INT TERM
mkdir "$work/delta"
ucode -L /usr/share/podkop-config-auto-updater /usr/share/podkop-config-auto-updater/worker.uc "$1" "$work"
